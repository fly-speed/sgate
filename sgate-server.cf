# Generic example; set the password and addresses before deployment. Set master_disable = no to run under acl_master.
service sgate-server {
    # Disable service loading in acl_master: yes blocks autostart and master_ctl start; no enables both. Standalone startup is unaffected.
    master_disable = no
    # acl_master service type; sock lets the framework manage listening sockets.
    master_type = sock
    # acl_master listen address in IP|port format; omit the IP to listen on all interfaces.
    master_service = |1080
    # Enable SO_REUSEPORT; no lets acl_master own and pass listening sockets to child processes.
    master_reuseport = no
    # Maximum child process count; the current configuration uses one process to maintain tunnel sessions.
    master_maxproc = 1
    # Prefork child process count; must not exceed master_maxproc.
    master_prefork = 1
    # Report child process busy/idle status to acl_master; 0 disables reporting.
    master_status_notify = 0
    # Run as the framework's configured unprivileged identity; n disables identity switching, y enables it.
    master_unpriv = n
    # Enable chroot isolation; n disables it, y enables it.
    master_chroot = n
    # Use SIGTERM when the framework stops or restarts a service; false keeps the framework's original stop sequence.
    master_stop_kill = false
    # Wait for the old child process to exit when master_stop_kill is enabled.
    master_stop_wait = true
    # Use private framework socket directories; n uses public directories, y uses private directories.
    master_private = n
    # Absolute path to the executable launched by acl_master.
    master_command = /opt/soft/sgate/sbin/sgate-server
    # Additional CLI overrides, normally empty; the framework supplies -f <this file>.
    master_args =
    # Working directory used by acl_master for the child process; relative application paths resolve from here.
    master_home = /opt/soft/sgate/var

# Framework monitoring, notifications and logging: resource monitoring is disabled in this generic example; logs use the install directory.
    # Collect child process file descriptor statistics; this generic example keeps the framework default of disabled.
    master_check_fds = false
    # Collect child process memory statistics; this generic example keeps the framework default of disabled.
    master_check_mem = false
    # Collect child process CPU statistics; this generic example keeps the framework default of disabled.
    master_check_cpu = false
    # Collect child process I/O statistics; this generic example keeps the framework default of disabled.
    master_check_io = false
    # Check child process resource limits; this generic example keeps the framework default of disabled.
    master_check_limit = false
    # Child process failure notification service address; no uses the framework's default monitoring socket.
    master_notify_addr = no
    # Email recipients for failure notifications; no leaves recipients unspecified.
    master_notify_recipients = no
    # Service version identifier; none retains the framework's unspecified-version default.
    master_version = none
    # Wakeup interval in seconds, used only by trigger services; leave - for sock services.
    master_wakeup = -
    # Service log file; ensure its directory exists and is writable by the service account.
    master_log = /opt/soft/sgate/logs/sgate-server.log
    # Standard output redirection file when managed by acl_master.
    master_stdout = /opt/soft/sgate/logs/sgate-server-stdout.log
    # Standard error redirection file when managed by acl_master.
    master_stderr = /opt/soft/sgate/logs/sgate-server-stderr.log

# Proxy configuration: loaded by the service template; same-name CLI options take precedence.
    # UTF-8 application configuration. Precedence: explicit CLI options > this file > built-in defaults.
    # Relative application paths resolve from the process working directory.
    # Standalone proxy listen address; shared management allows HTTP on any interface. Set tls-cert/tls-key for HTTPS/WSS.
    listen = 127.0.0.1:8081
    # Default backend TCP address forwarded by the server, in host:port format.
    target = 127.0.0.1:8080
    # Comma-separated allowed backends selectable through client addr; exact host:port matching, with IPs or domain names.
    # Empty disallows client-selected backends; requests without addr still use target above. Example: 127.0.0.1:8088,example.com:443
    # Saved changes apply immediately to new tunnels and reconnects; existing tunnels continue. Explicit CLI values take priority.
    allowed-targets = "127.0.0.1:8080"
    # WebSocket tunnel path; must match the client server URL path. Management uses /admin/.
    path = /tunnel
    # Shared encryption key file for both endpoints; relative paths resolve from the process working directory.
    key-file = sgate.key
    # Legacy tunnel authentication password, used only when accounts-file is empty; separate from Web administrator credentials.
    password = 'replace-with-your-password'
    # Optional tunnel-account JSON, relative to this .cf; the Web interface can initialize it on the first account addition. Nonempty disables legacy password authentication.
    # A missing configured file is created on startup with version 1 and accounts: []; add users through the Web interface.
    # Empty account lists deny all tunnel connections and never fall back to the legacy password.
    # Saving a changed path loads it online without restarting; invalid files retain the existing policy. Explicit CLI options take priority.
    # Clearing restores the already-active legacy password; revoked accounts lose their tunnels, while unchanged accounts keep theirs.
    # accounts-file = '/opt/soft/sgate/conf/tunnel-accounts.json'
    accounts-file = ''
    # HTTPS/WSS certificate PEM file; set together with tls-key. Leave both empty for HTTP/WS.
    tls-cert =
    # HTTPS/WSS certificate private key PEM file; set together with tls-cert.
    tls-key =
    # Server retention period for disconnected tunnel sessions; release old application connections and replay buffers on expiry.
    session-ttl = 2m
    # Maximum number of tunnel sessions retained by the server.
    max-sessions = 128
    # Maximum concurrent TCP application connections per tunnel session.
    max-streams = 128
    # Unacknowledged data limit per session and direction, in bytes; apply backpressure at the limit.
    buffer-bytes = 4194304
    # WebSocket heartbeat interval; supports units such as ms, s and m.
    heartbeat = 20s
    # Receive idle timeout; 0 uses three times heartbeat. Custom values must pass timeout validation.
    heartbeat-timeout = 0
    # Fixed padding interval; sending is disabled when this and both random interval bounds are 0.
    noise-interval = 0
    # Set random interval min/max to 1s/3s to send at random 1-3 second intervals.
    # Minimum random padding interval; set both bounds positive, such as 1s/3s, to enable it. The fixed interval must then be 0.
    noise-interval-min = "100ms"
    # Maximum random padding interval, such as 3s; must be at least noise-interval-min.
    noise-interval-max = "2000ms"
    # Minimum random padding payload per burst, in bytes; must be at least 1.
    noise-min-bytes = "10K"
    # Maximum random padding payload per burst, in bytes; must be at least the minimum and at most 10M (10485760 bytes). Supports K/M.
    noise-max-bytes = "500K"
    # Send padding during application traffic; true preserves the original behavior, false pauses it during traffic in either direction.
    noise-traffic = "false"
    # Send padding when application connections exist but neither direction has data; use the interval and size settings above.
    noise-idle = "true"
    # Send padding when the tunnel is online with no application connections; true sends, false pauses. Heartbeats are unaffected.
    noise-empty = "true"
    # A connection is idle after this duration without application data in either direction. Units: ms/s/m/h. 0 uses 1s; new unused connections are idle immediately.
    noise-idle-after = 1s

    # Optional separate management configuration file; a nonempty value loads that file and enables management.
    # Leave empty to enable this .cf file's management settings through admin_enabled or -admin-enabled.
    admin-config =

# Web management configuration: disabled by default; enable with -admin-enabled.
# Accounts and persistent sessions remain separate data files; relative paths below resolve from this .cf file's directory.
    # Enable Web management, disabled by default; -admin-enabled overrides this setting.
    admin_enabled = true
    # External HTML/CSS/JS directory, relative to this .cf file; absolute paths are also supported.
    admin_web_dir = web/admin
    # Management shares the proxy listen/master_service port at /admin/; there is no separate management listener.
    # Separate administrator account file (password hashes), relative to this .cf file.
    admin_users_file = conf/admin-server-users.json
    # Persistent login session directory, relative to this .cf file.
    admin_session_dir = conf/admin-server-sessions
    # Fixed login session lifetime, preserved across process restarts.
    admin_session_timeout = 12h
    # Maximum number of stored management login sessions.
    admin_max_sessions = 128
    # One-time token file used to create the first administrator account.
    admin_setup_token_file = conf/admin-server-setup.token
    # Server management reuses the proxy tls-cert/tls-key; the legacy management certificate settings below are unused.
    admin_tls_cert =
    # Legacy management private key setting, retained only for compatibility.
    admin_tls_key =
    # acl_master control executable for the management page's restart action; defaults to the installed master_ctl.
    admin_master_ctl = /opt/soft/acl-master/bin/master_ctl
    # acl_master control socket path; leave empty for the master_ctl default, or set an explicit absolute path.
    admin_master_socket =
}
