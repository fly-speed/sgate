# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Local builds and credentials
/bin/
/sgate.key
#/tls-cert.pem
#/tls-key.pem
/artifacts/

# Web management runtime credentials, cookies, initialization tokens and backups
/conf/admin-*-users.json
/conf/admin-*-sessions/
/conf/admin-*-setup.token
/conf/*.conf.bak

# Backups of unified service configuration files
/*.cf.bak
