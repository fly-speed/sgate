service vpn-server {
#	Disable this service process.
	master_disable = no
#	Service listen address and port.
	master_service = |1088

#	Service type.
	master_type = sock
# acl_master owns listening sockets inherited by Go; management restarts replace only the proxy worker.
	master_reuseport = no
	# Use SIGTERM when the framework stops or restarts a service; false keeps the framework's original stop sequence.
	master_stop_kill = false
	# Wait for the old child process to exit when master_stop_kill is enabled.
	master_stop_wait = true


	# Collect child process file descriptor statistics.
	master_check_fds = true
	# Collect child process memory statistics.
	master_check_mem = true
	# Collect child process CPU statistics.
	master_check_cpu = true
	# Collect child process I/O statistics.
	master_check_io  = true
	# Check child process resource limits.
	master_check_limit = true

#	If nonempty, notify this service when a child process exits abnormally.
	master_notify_addr = /opt/soft/acl-master/var/public/monitor.sock
#	Email notification recipients.
	master_notify_recipients = zhengshuxin@hotmail.com

#	Enable deferred accept: 0 disables it, a positive value enables it.
#	This value is also the deferred accept timeout; if the client still sends no data before it expires,
#	the operating system closes the connection directly.
#	master_defer_accept = 0
#	Restrict to private access: for y, the Unix socket is created under /opt/soft/acl-master/var/log/private/.
#	For n, the Unix socket is created under /opt/soft/acl-master/var/log/public/.
	master_private = n
	# Run as the framework's configured unprivileged identity; n disables identity switching, y enables it.
	master_unpriv = n
#	Enable chroot: n -- no, y -- yes.
	master_chroot = n
#	Wakeup interval in seconds (trigger mode only).
	master_wakeup = -
#	Maximum process count.
	master_maxproc = 1
#	Prefork child process count; must not exceed master_maxproc.
	master_prefork = 1
#	Executable path.
	master_command = /opt/soft/sgate/sbin/sgate-server
	# Service version identifier used by acl_master for management and display.
	master_version = 1.0.0-0
#	Process log file.
	master_log = /opt/soft/sgate/logs/vpn-server.log
	# Standard output redirection log file.
	master_stdout = /opt/soft/sgate/logs/vpnd-stdout.log
	# Standard error redirection log file.
	master_stderr = /opt/soft/sgate/logs/vpnd-stderr.log
#	Debug logging format: tag:level; tag:level; tab:level. Examples: all:1; 101:2
#	master_debug =
# Additional CLI overrides, normally empty; the framework supplies -f <this file>.
    master_args =
	# Working directory used by acl_master for the child process; relative application paths resolve from here.
	master_home = /opt/soft/sgate/var
#	Environment variables passed to the child service; available through getenv("SERVICE_ENV").
#	master_env = mempool_limit:512000000
#	master_env = logme:FALSE, priority:E_LOG_INFO, action:E_LOG_PER_DAY, flush:sync_flush, imit_size:512,\
#			sync_action:E_LOG_SEM, sem_name:/tmp/ioctl_echo.sem

#	When multiple child instances run, control whether they report their status to acl_master on accepting connections.
	master_status_notify = 0
#	Allow core dumps.

# Proxy configuration: loaded by the service template; same-name CLI options take precedence.
    # vpn-server application configuration (UTF-8).
    # Precedence: explicit CLI options > this file > built-in defaults.
    # Relative paths resolve from the process working directory; retain existing addresses, passwords and certificates.

    # Connections and authentication
    # HTTP/HTTPS listen address; HTTP management is allowed on any interface. Retain the existing address.
    listen = ":1088"
    # Default backend TCP address; retain the existing address.
    target = "127.0.0.1:2900"
    # Comma-separated allowed backends selectable through client addr; exact host:port matching, with IPs or domain names.
    # Empty disallows client-selected backends; requests without addr still use target above. Example: 127.0.0.1:8088,example.com:443
    allowed-targets =
    # WebSocket endpoint path; default: /tunnel. Must match the client URL path.
    path = "/tunnel"
    # Shared key file for both endpoints; retain the existing path.
    key-file = "/opt/soft/sgate/conf/sgate.key"
    # Connection authentication password; must match on both endpoints. Retain the existing value.
    password = "8ik.%^.lo9&*(MJ"

    # TLS certificates and trust
    # HTTPS certificate PEM file; retain the existing path and set together with tls-key.
    tls-cert = "/opt/soft/nginx/conf/webcool.cn_ecc/fullchain.cer"
    # HTTPS certificate private key PEM file; retain the existing path.
    tls-key = "/opt/soft/nginx/conf/webcool.cn_ecc/webcool.cn.key"

    # Reconnection and session retention
    # Disconnected session retention; default: 2 minutes. Await reconnect, then release old connections and buffers on expiry.
    session-ttl = 2m
    # Maximum retained server sessions; default: 128.
    max-sessions = 128

    # Stream and buffer limits
    # Maximum concurrent TCP streams per session; default: 128.
    max-streams = 128
    # Unacknowledged data limit per session and direction, in bytes; default: 4 MiB. Apply backpressure when full.
    buffer-bytes = 4194304

    # Heartbeats
    # Custom receive timeouts must exceed the heartbeat interval and pass dial/write timeout validation.
    # WebSocket heartbeat interval; default: 20 seconds.
    heartbeat = 20s
    # Receive idle timeout; 0 uses three times the heartbeat interval, currently 60 seconds by default.
    heartbeat-timeout = 0

    # Random padding (disabled by default)
    # For random 1-3 second intervals, keep noise-interval = 0 and set min/max below to 1s/3s.
    # For a fixed interval, set min/max to 0 and set noise-interval to a positive duration such as 1s.
    # Configure each endpoint independently; an endpoint with sending disabled still receives and discards peer padding.
    # Fixed padding interval; 0 disables fixed-interval sending. Padding is disabled by default.
    noise-interval = 0
    # Minimum random wait; default: 0. Set both bounds positive to enable random intervals.
    noise-interval-min = 0
    # Maximum random wait; default: 0. Must be at least the minimum; cannot be combined with a nonzero fixed interval.
    noise-interval-max = 0
    # Minimum random padding payload per burst, in bytes; default: 1024.
    noise-min-bytes = 1024
    # Maximum random padding payload per burst; default: 10240 bytes. Range: 1-10M (10485760 bytes); K/M suffixes are supported.
    noise-max-bytes = 10240
    # Send padding during application traffic; true preserves the original behavior, false pauses it during traffic in either direction.
    noise-traffic = true
    # Send padding when application connections exist but neither direction has data; use the interval and size settings above.
    noise-idle = true
    # Send padding when the tunnel is online with no application connections; true sends, false pauses. Heartbeats are unaffected.
    noise-empty = true
    # A connection is idle after this duration without application data in either direction. Units: ms/s/m/h. 0 uses 1s; new unused connections are idle immediately.
    noise-idle-after = 1s

    # Optional separate management configuration file; a nonempty value loads that file and enables management.
    # Leave empty to enable this .cf file's management settings through admin_enabled or -admin-enabled.
    admin-config =

# Web management configuration: disabled by default; enable with -admin-enabled.
# Accounts and persistent sessions remain separate data files; relative paths below resolve from this .cf file's directory.
    # Enable Web management, disabled by default; -admin-enabled overrides this setting.
    admin_enabled = false
    # External HTML/CSS/JS directory, relative to this .cf file; absolute paths are also supported.
    admin_web_dir = ../web/admin
    # Management shares the proxy listen/master_service port at /admin/; there is no separate management listener.
    # Separate administrator account file (password hashes), relative to this .cf file.
    admin_users_file = ../conf/admin-server-users.json
    # Persistent login session directory, relative to this .cf file.
    admin_session_dir = ../conf/admin-server-sessions
    # Fixed login session lifetime, preserved across process restarts.
    admin_session_timeout = 12h
    # Maximum number of stored management login sessions.
    admin_max_sessions = 128
    # One-time token file used to create the first administrator account.
    admin_setup_token_file = ../conf/admin-server-setup.token
    # Server management reuses the proxy tls-cert/tls-key; the legacy management certificate settings below are unused.
    admin_tls_cert =
    # Legacy management private key setting, retained only for compatibility.
    admin_tls_key =
    # acl_master control executable for the management page's restart action; defaults to the installed master_ctl.
    admin_master_ctl = /opt/soft/acl-master/bin/master_ctl
    # acl_master control socket path; leave empty for the master_ctl default, or set an explicit absolute path.
    admin_master_socket =

# Independent IPv4 VPN (TUN + QUIC DATAGRAM): disabled by default; does not require OpenVPN.
# Both clients and servers support macOS/Linux. Enabling VPN requires network administration privileges.
# Stop other full-tunnel VPNs before enabling. These settings can also be edited through Web management.
# The original section of this example proxies OpenVPN; select only and stop OpenVPN to use the independent VPN.
    # VPN mode: disabled turns VPN off; both runs proxy and VPN; only runs VPN while retaining framework and management listeners. Applying VPN changes interrupts VPN and restores/rebuilds its network configuration. Other VPN options are ignored while disabled and validated when enabled.
    vpn-mode = disabled
    # IPv4 VPN subnet; must match on both ends and must not overlap existing networks.
    vpn-network = 10.77.0.0/24
    # TUN MTU in bytes, from 576 to 1500.
    vpn-mtu = 1280
    # Queue expiry: 0 disables age drops (recommended for weak-link TCP); maximum 1m.
    vpn-queue-max-age = 0s
    # New TUN device name; empty uses sgate0 on Linux or automatically allocates utunN on macOS.
    vpn-tun-name = ''
    # Automatically configure routes, DNS or server NAT; requires administrator privileges.
    vpn-manage-network = true
    # VPN shared key file; empty reuses key-file. VPN authentication is separate from proxy and Web accounts.
    vpn-key-file = ''
    # Per authenticated VPN connection, local padding payload bytes/second; K/M supported, 0 disables, maximum 10M.
    vpn-noise-rate = 0
    # Allow padding during business IP traffic; queued business data and congestion take priority.
    vpn-noise-traffic = true
    # Allow padding on connected but idle VPN tunnels; no business connection is required.
    vpn-noise-idle = true
    # IP inactivity threshold; padding does not reset it. Zero uses 1s.
    vpn-noise-idle-after = 1s
    # Separate QUIC UDP listener; cannot share a UDP port with quic-listen.
    vpn-listen = 0.0.0.0:8444
    # Optional TLS/TCP and WSS listener; may share the numeric UDP port.
    vpn-tcp-listen = ''
    # VPN server certificate PEM; empty reuses tls-cert.
    vpn-tls-cert = ''
    # VPN certificate private key PEM; empty reuses tls-key.
    vpn-tls-key = ''
    # Maximum simultaneous authenticated clients, from 1 to 254; each client needs a unique virtual IP.
    vpn-max-clients = 64
    # macOS/Linux physical egress interface; empty detects it from the current route.
    vpn-egress-interface = ''
    # Allow access to private networks on the server side; inter-client traffic is always denied.
    vpn-allow-private = false

}
