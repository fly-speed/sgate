service web-client {
#	进程是否禁止运行
	master_disable = no
#	服务地址及端口号
	master_service = 127.0.0.1|1088

#	服务类型
	master_type = sock
# acl_master 持有监听端口，Go 服务继承套接字；管理界面重启仅替换代理工作实例。
	master_reuseport = no
	# 框架停止或重启服务时是否采用发送 SIGTERM 的方式；false 使用框架原有停止流程。
	master_stop_kill = false
	# 当 master_stop_kill 启用时，是否等待旧子进程退出。
	master_stop_wait = true


	# 是否采集子进程的文件描述符使用情况。
	master_check_fds = true
	# 是否采集子进程的内存使用情况。
	master_check_mem = true
	# 是否采集子进程的 CPU 使用情况。
	master_check_cpu = true
	# 是否采集子进程的 I/O 使用情况。
	master_check_io  = true
	# 是否检查子进程资源限制。
	master_check_limit = true

#	当子进程异常退出时，如果该值非空，则将子进程异常退出的消息通知该服务
	master_notify_addr = /opt/soft/acl-master/var/public/monitor.sock
#	邮件通知接收者
	master_notify_recipients = zhengshuxin@hotmail.com

#	是否允许延迟接受客户端连接，如果为0则表示关闭该功能，如果大于0则表示打开此功能
#	并且此值代表延迟接受连接的超时值，超过此值时如果客户端依然没有发来数据，则操作
#	系统会在系统层直接关闭该连接
#	master_defer_accept = 0
#	是否只允许私有访问, 如果为 y, 则域套接口创建在 /opt/soft/acl-master/var/log/private/ 目录下,
#	如果为 n, 则域套接口创建在 /opt/soft/acl-master/var/log/public/ 目录下,
	master_private = n
	# 是否以框架配置的非特权身份运行；n 不切换身份，y 启用。
	master_unpriv = n
#	是否需要 chroot: n -- no, y -- yes
	master_chroot = n
#	每隔多长时间触发一次，单位为秒(仅对 trigger 模式有效)
	master_wakeup = -
#	最大进程数
	master_maxproc = 1
#	预启动进程数，该值不得大于 master_maxproc
	master_prefork = 1
#	进程程序名
	master_command = /opt/soft/sgate/sbin/sgate-client
	# 服务版本标识，供 acl_master 管理与展示使用。
	master_version = 1.0.0-0
#	进程日志记录文件
	master_log = /opt/soft/sgate/logs/web-client.log
	# 服务标准输出的重定向日志文件路径。
	master_stdout = /opt/soft/sgate/logs/stdout.log
	# 服务标准错误的重定向日志文件路径。
	master_stderr = /opt/soft/sgate/logs/stderr.log
#	调试日志方式，格式：tag:level; tag:level; tab:level, 如：all:1; 101:2
#	master_debug =
# 附加命令行覆盖项，通常留空；框架自动传入 -f <本文件>。
    master_args =
	# acl_master 启动服务子进程时使用的工作目录；业务相对路径以此目录解析。
	master_home = /opt/soft/sgate/var
#	传递给服务子进程的环境变量, 可以通过 getenv("SERVICE_ENV") 获得此值
#	master_env = mempool_limit:512000000
#	master_env = logme:FALSE, priority:E_LOG_INFO, action:E_LOG_PER_DAY, flush:sync_flush, imit_size:512,\
#			sync_action:E_LOG_SEM, sem_name:/tmp/ioctl_echo.sem

#	当启动多个子进程实例时，该开关控制多个子进程在接收连接时是否向 acl_master 发送消息报告自己的状态
	master_status_notify = 0
#	是否允许产生 core 文件

# 代理配置：使用服务模板读取，命令行同名参数优先。
    # web-client 应用配置（UTF-8）。
    # 参数优先级：命令行显式参数 > 本文件 > 内置默认值。
    # 相对路径以进程工作目录为基准；原有地址、密码和证书配置保持不变。

    # 连接与身份验证
    # 本地应用连接的 TCP 监听地址；保留现有地址。
    listen = "127.0.0.1:1088"
    # 服务端 WebSocket URL；保留现有协议、地址、端口及路径。
    server = "ws://i18n.webcool.cn:8088/tunnel"
    # 服务端所连接的后端；非空时覆盖 server URL 中的 addr，支持 IP:端口或域名:端口。
    # 留空保留 URL 中的选择；URL 也无 addr 时使用服务端默认后端，所选地址须在服务端允许列表内。
    addr =
    # 是否在请求 URL 中携带目标地址；false 忽略独立 addr 并移除 URL 的 addr，使用服务端默认后端。
    send-addr = true
    # 两端共享密钥文件路径；保留现有路径。
    key-file = "/opt/soft/sgate/conf/sgate.key"
    # 连接验证密码，须与服务端一致；Web 原配置留空，部署前填写或用 -password 提供。
    password = ""

    # TLS 证书与信任
    # 附加可信 CA 的 PEM 文件路径；空值使用系统信任库，WSS 仍校验证书。
    tls-ca = ""

    # 断线重连与会话保留
    # 自动重连退避的最小间隔，默认 250 毫秒；实际等待带随机抖动。
    reconnect-min = 250ms
    # 自动重连退避的最大间隔，默认 10 秒。
    reconnect-max = 10s
    # 断网时保留应用连接和重放缓存的期限，默认 2 分钟；到期释放旧连接和缓存。
    offline-timeout = 2m

    # 流与缓存上限
    # 每个会话允许同时存在的 TCP 流上限，默认 128。
    max-streams = 128
    # 每会话、每方向未确认数据缓存上限，单位字节，默认 4 MiB；满后通过背压等待。
    buffer-bytes = 4194304

    # 心跳
    # 自定义接收超时必须大于心跳间隔，并满足程序的拨号、写入超时校验。
    # WebSocket 心跳发送间隔，默认 20 秒。
    heartbeat = 20s
    # 接收空闲超时；0 按心跳间隔的三倍计算，当前默认 60 秒。
    heartbeat-timeout = 0

    # 随机白噪音（默认关闭）
    # 启用每隔 1～3 秒随机发送：保留 noise-interval = 0，将下面 min/max 改为 1s/3s。
    # 启用固定间隔：将 min/max 均设为 0，再将 noise-interval 改为 1s 等正值。
    # 双端独立配置；未启用发送的一端仍可接收并丢弃对端的白噪音。
    # 固定白噪音发送间隔；0 表示不使用固定间隔，默认不主动发送白噪音。
    noise-interval = 0
    # 随机等待时间下限，默认 0；与上限同时设为正值才启用随机间隔。
    noise-interval-min = 0
    # 随机等待时间上限，默认 0；必须不小于下限，不能与非零固定间隔混用。
    noise-interval-max = 0
    # 每次白噪音随机负载的最小字节数，默认 1024。
    noise-min-bytes = 1024
    # 每次白噪音随机负载的最大字节数，默认 10240；允许范围为 1～10M（10485760 字节），支持 K/M 后缀。
    noise-max-bytes = 10240
    # 业务传输中是否混入白噪音；true 保留原行为，false 在双向业务活跃时暂停。
    noise-traffic = true
    # 有业务连接但双向无数据时是否发送；沿用上面的固定或随机间隔与大小。
    noise-idle = true
    # 无业务连接但隧道在线时是否发送；true 发送，false 暂停，不影响心跳。
    noise-empty = true
    # 连续无双向业务数据达到此时间算空闲；单位 ms/s/m/h，0 使用 1s，新建无流量连接直接视为空闲。
    noise-idle-after = 1s

    # 可选的独立管理配置文件；非空时使用该文件并启用管理界面。
    # 留空则通过 admin_enabled 或 -admin-enabled 开启本 .cf 中的管理配置。
    admin-config =

# Web 管理配置：默认关闭；命令行 -admin-enabled 可开启。
# 账号和持久化会话仍是独立数据文件，下面的相对路径以本 .cf 所在目录为基准。
    # 是否启用 Web 管理，默认关闭；命令行 -admin-enabled 可覆盖
    admin_enabled = false
    # 外部 HTML/CSS/JS 目录，相对本 .cf 解析；也可使用绝对路径
    admin_web_dir = ../web/admin
    # 管理监听地址，与代理监听端口独立
    admin_listen = 127.0.0.1:9081
    # 独立管理员账号文件（哈希存储），相对本 .cf 解析
    admin_users_file = ../conf/admin-client-users.json
    # 持久化登录会话目录，相对本 .cf 解析
    admin_session_dir = ../conf/admin-client-sessions
    # 登录会话固定有效期，进程重启后继续有效
    admin_session_timeout = 12h
    # 最多保存的管理登录会话数
    admin_max_sessions = 128
    # 首次创建管理员账号时使用的一次性令牌文件
    admin_setup_token_file = ../conf/admin-client-setup.token
    # 管理界面 HTTPS 证书，留空则使用 HTTP
    admin_tls_cert =
    # 管理界面 HTTPS 私钥，须与证书同时配置
    admin_tls_key =
    # acl_master 控制程序路径，用于管理页面重启客户端服务。
    admin_master_ctl = /opt/soft/acl-master/bin/master_ctl
    # 框架管理套接字路径；留空使用 master_ctl 默认设置，可填写绝对路径。
    admin_master_socket =
}
